# Public Supabase (exposed to browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-only (NEVER expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Admin allowlist: only this email sees /admin
ADMIN_EMAIL=ali.hassooo11@gmail.com

# n8n order/stock workflow webhook
N8N_WEBHOOK_URL=https://your-n8n-host/webhook/order-stock

# n8n support ticket notification webhook (separate workflow)
N8N_TICKET_WEBHOOK_URL=https://your-n8n-host/webhook/support-ticket
